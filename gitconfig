# ==============================================================================
# USER IDENTITY
# Identificación para commits - se usa en toda la repo
# ==============================================================================

[user]
    name = gagocaan
    email = gagocaan@gmail.com
    # signingkey = ~/.ssh/id_ed25519.pub  # Descomenta para firmar commits con SSH

# ==============================================================================
# COMMIT SETTINGS
# ==============================================================================

[commit]
    # gpgsign = true  # Descomenta para firmar commits con GPG (recomendado DevOps/Security)

# ==============================================================================
# GPG/SSH SETTINGS
# ==============================================================================

[gpg]
    # Usar SSH keys para firmar en lugar de GPG
    format = ssh

# ==============================================================================
# CORE SETTINGS
# ==============================================================================

[core]
    # Editor para commits, rebase, etc - usa Neovim
    editor = nvim

    # Pager: usar delta para diffs con syntax highlighting
    pager = delta

    # Búsqueda case-sensitive (no ignorar mayúsculas)
    ignorecase = false

    # FileSystem Monitor: mejora performance en repos grandes
    fsmonitor = true

    # Cache de archivos no trackeados - acelera comandos
    untrackedCache = true

# ==============================================================================
# INITIALIZATION
# ==============================================================================

[init]
    # Default branch para nuevos repos
    defaultBranch = main

# ==============================================================================
# FETCH SETTINGS
# ==============================================================================

[fetch]
    # Limpiar branches remotos borrados (evita "stale branches")
    prune = true

    # Limpiar tags borrados en remote
    pruneTags = true

# ==============================================================================
# PULL SETTINGS
# ==============================================================================

[pull]
    # Usar rebase en lugar de merge para mantener historia lineal
    rebase = true

# ==============================================================================
# PUSH SETTINGS
# ==============================================================================

[push]
    # Auto-crear remote al hacer push de branch nueva
    autoSetupRemote = true

    # Push al branch actual por defecto (no usar "git push" solo)
    default = current

    # Push tags automáticamente al hacer push
    followTags = true

# ==============================================================================
# MERGE SETTINGS
# ==============================================================================

[merge]
    # Mostrar conflictos en formato "zdiff3" - más claro que diff3
    conflictstyle = zdiff3

# ==============================================================================
# DIFF SETTINGS
# ==============================================================================

[diff]
    # Color para líneas movidas en diffs
    colorMoved = default

    # Algoritmo de diff - histogram es más rápido y mejor para código
    algorithm = histogram

# ==============================================================================
# INTERACTIVE MODE
# ==============================================================================

[interactive]
    # Usar delta para colorear diffs en "git add -p"
    diffFilter = delta --color-only

# ==============================================================================
# DELTA SETTINGS (Git Pager)
# Delta = pager moderno con syntax highlighting
# ==============================================================================

[delta]
    # Habilitar navegación (j/k para mover entre hunks)
    navigate = true

    # Mostrar números de línea
    line-numbers = true

    # Side-by-side: false = unified diff (recomendado)
    side-by-side = false

    # Tema de colors - Dracula
    syntax-theme = Dracula

    # Estilo de líneas añadidas (verde)
    plus-style = "syntax #012800"

    # Estilo de líneas borradas (rojo)
    minus-style = "syntax #340001"

# ==============================================================================
# BRANCH SETTINGS
# ==============================================================================

[branch]
    # Ordenar branches por fecha de commit más reciente
    sort = -committerdate

# ==============================================================================
# COLUMN LAYOUT
# ==============================================================================

[column]
    # Auto-formatear output en columnas cuando sea apropiado
    ui = auto

# ==============================================================================
# RERERE (Reuse Recorded Resolution)
#rememberear resolución de conflictos
# ==============================================================================

[rerere]
    # Guardar cómo resoliste conflictos para reutilizar en el futuro
    enabled = true

# ==============================================================================
# HELP SETTINGS
# ==============================================================================

[help]
    # Auto-ejecutar comando después de 1 segundo de tipeo (10 = 1 seg)
    autocorrect = 10

# ==============================================================================
# ALIASES
# ==============================================================================

[alias]
    # === Shortcuts básicos ===
    st = status           # git st
    co = checkout         # git co
    br = branch           # git br
    ci = commit           # git ci
    aa = add --all        # git aa

    # === Diff ===
    df = diff             # git df
    dc = diff --cached    # git dc (staged changes)

    # === Log ===
    # Historial visual con colors
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

    # Log con todas las ramas
    lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all

    # === Utilities ===
    unstage = reset HEAD --     # git unstage (sacar del staging)
    last = log -1 HEAD          # git last (último commit)
    undo = reset HEAD~1 --mixed # git undo (deshacer commit sin perder cambios)
    amend = commit --amend      # git amend (agregar al último commit)

    # === 2026 Aliases ===
    ifi = flow init -d          # git ifi - Inicializar git-flow rápidamente
    gone = !git fetch -p && git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D  # git gone - Limpiar branches borradas en remote
    summary = shortlog -sn      # git summary - Quién ha hecho cuántos commits

# ==============================================================================
# GIT-FLOW SETTINGS
# ==============================================================================

[gitflow "branch"]
    # Branch principal
    master = main
    # Branch de desarrollo
    develop = develop

[gitflow "prefix"]
    # Prefijos para branches
    feature = feature/
    release = release/
    hotfix = hotfix/
    support = support/
    # Tags de versión
    versiontag = v