# ==============================================================================
# USER IDENTITY
# Identification for commits - used throughout the repo
# ==============================================================================

[user]
    name = gagocaan
    email = gagocaan@gmail.com
    # signingkey = ~/.ssh/id_ed25519.pub  # Uncomment to sign commits with SSH

# ==============================================================================
# COMMIT SETTINGS
# ==============================================================================

[commit]
    # gpgsign = true  # Uncomment to sign commits with GPG (recommended for DevOps/Security)

# ==============================================================================
# GPG/SSH SETTINGS
# ==============================================================================

[gpg]
    # Use SSH keys for signing instead of GPG
    format = ssh

# ==============================================================================
# CORE SETTINGS
# ==============================================================================

[core]
    # Editor for commits, rebase, etc — uses Neovim
    editor = nvim

    # Pager: use delta for diffs with syntax highlighting
    pager = delta

    # Case-sensitive search (do not ignore case)
    ignorecase = false

    # FileSystem Monitor: improves performance on large repos
    fsmonitor = true

    # Untracked file cache — speeds up commands
    untrackedCache = true

# ==============================================================================
# INITIALIZATION
# ==============================================================================

[init]
    # Default branch for new repos
    defaultBranch = main

# ==============================================================================
# FETCH SETTINGS
# ==============================================================================

[fetch]
    # Remove deleted remote branches (prevents stale branches)
    prune = true

    # Remove deleted remote tags
    pruneTags = true

# ==============================================================================
# PULL SETTINGS
# ==============================================================================

[pull]
    # Use rebase instead of merge to keep a linear history
    rebase = true

# ==============================================================================
# PUSH SETTINGS
# ==============================================================================

[push]
    # Auto-create remote when pushing a new branch
    autoSetupRemote = true

    # Push to current branch by default
    default = current

    # Automatically push tags on push
    followTags = true

# ==============================================================================
# MERGE SETTINGS
# ==============================================================================

[merge]
    # Show conflicts in "zdiff3" format — clearer than diff3
    conflictstyle = zdiff3

# ==============================================================================
# DIFF SETTINGS
# ==============================================================================

[diff]
    # Color for moved lines in diffs
    colorMoved = default

    # Diff algorithm — histogram is faster and better suited for code
    algorithm = histogram

# ==============================================================================
# INTERACTIVE MODE
# ==============================================================================

[interactive]
    # Use delta to colorize diffs in "git add -p"
    diffFilter = delta --color-only

# ==============================================================================
# DELTA SETTINGS (Git Pager)
# Delta = modern pager with syntax highlighting
# ==============================================================================

[delta]
    # Enable navigation (j/k to move between hunks)
    navigate = true

    # Show line numbers
    line-numbers = true

    # Side-by-side: false = unified diff (recommended)
    side-by-side = false

    # Color theme — Dracula
    syntax-theme = Dracula

    # Style for added lines (green)
    plus-style = "syntax #012800"

    # Style for removed lines (red)
    minus-style = "syntax #340001"

# ==============================================================================
# BRANCH SETTINGS
# ==============================================================================

[branch]
    # Sort branches by most recent commit date
    sort = -committerdate

# ==============================================================================
# COLUMN LAYOUT
# ==============================================================================

[column]
    # Auto-format output in columns when appropriate
    ui = auto

# ==============================================================================
# RERERE (Reuse Recorded Resolution)
# Remember conflict resolution for reuse
# ==============================================================================

[rerere]
    # Save how you resolved conflicts to reuse in the future
    enabled = true

# ==============================================================================
# HELP SETTINGS
# ==============================================================================

[help]
    # Auto-run corrected command after 1 second (10 = 1 sec)
    autocorrect = 10

# ==============================================================================
# ALIASES
# ==============================================================================

[alias]
    # === Basic shortcuts ===
    st = status           # git st
    co = checkout         # git co
    br = branch           # git br
    ci = commit           # git ci
    aa = add --all        # git aa

    # === Diff ===
    df = diff             # git df
    dc = diff --cached    # git dc (staged changes)

    # === Log ===
    # Visual history with colors
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

    # Log across all branches
    lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all

    # === Utilities ===
    unstage = reset HEAD --     # git unstage (remove from staging)
    last = log -1 HEAD          # git last (most recent commit)
    undo = reset HEAD~1 --mixed # git undo (undo commit without losing changes)
    amend = commit --amend      # git amend (add to last commit)

    # === 2026 Aliases ===
    ifi = flow init -d          # git ifi - Initialize git-flow quickly
    gone = !git fetch -p && git branch -vv | awk '/: gone]/{print $1}' | xargs git branch -D  # git gone - Remove branches deleted on remote
    summary = shortlog -sn      # git summary - Who has made how many commits

# ==============================================================================
# GIT-FLOW SETTINGS
# ==============================================================================

[gitflow "branch"]
    # Main branch
    master = main
    # Development branch
    develop = develop

[gitflow "prefix"]
    # Branch prefixes
    feature = feature/
    release = release/
    hotfix = hotfix/
    support = support/
    # Version tags
    versiontag = v
