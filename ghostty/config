# Ghostty — macOS development terminal
# Managed from ~/.dotfiles and linked to ~/.config/ghostty/config.ghostty.

# -----------------------------------------------------------------------------
# Theme
# -----------------------------------------------------------------------------

theme = Dracula

# Keep Dracula visible while allowing the desktop to subtly bleed through.
background-opacity = 0.90
background-blur = 25
background-opacity-cells = true

minimum-contrast = 1.5


# -----------------------------------------------------------------------------
# Typography
# -----------------------------------------------------------------------------

font-family = "MesloLGS Nerd Font Mono"
font-family = "JetBrains Mono"

font-size = 16

# Slightly more vertical breathing room, closer to Warp.
adjust-cell-height = 6%

# Improves readability when using transparency.
font-thicken = true
font-thicken-strength = 15


# -----------------------------------------------------------------------------
# Window
# -----------------------------------------------------------------------------

window-width = 163
window-height = 48

# More balanced than the current 10 x 20.
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true
window-padding-color = background

# Makes the title bar part of the terminal surface.
macos-titlebar-style = transparent
macos-window-buttons = visible


# -----------------------------------------------------------------------------
# Cursor
# -----------------------------------------------------------------------------

cursor-style = bar
cursor-style-blink = false


# -----------------------------------------------------------------------------
# Shell integration
# -----------------------------------------------------------------------------

shell-integration = detect

# Warp-like command/block navigation
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1


# -----------------------------------------------------------------------------
# Interaction & Mouse
# -----------------------------------------------------------------------------

macos-option-as-alt = true

# Mouse support for inline command editing — click to position cursor in long commands
cursor-click-to-move = true
mouse-hide-while-typing = true


# -----------------------------------------------------------------------------
# macOS security
# -----------------------------------------------------------------------------

macos-auto-secure-input = true
macos-secure-input-indication = true
macos-shortcuts = ask