# ==============================================================================
# GHOSTTY CONFIG - Optimized for dotfiles stack
# ==============================================================================

# --- FONT & TEXT ---
font-family = "MesloLGS Nerd Font"
font-size = 16
font-feature = "-calt"

# --- WINDOW & APPEARANCE ---
window-theme = dark
theme = Catppuccin Mocha
background-opacity = 0.95
background-blur = true
window-padding-x = 8
window-padding-y = 8
window-title-font-family = "SF Pro Display"

# --- SHELL INTEGRATION ---
shell-integration = detect


# --- KEYBINDINGS (macOS/Cmd-based) ---
keybind = cmd+shift+v=paste_from_clipboard
keybind = cmd+shift+c=copy_to_clipboard:mixed
keybind = cmd+1=new_tab
keybind = cmd+2=new_split:right
keybind = cmd+w=close_surface
keybind = cmd+t=new_tab
keybind = cmd+n=new_window
keybind = cmd+f=toggle_command_palette
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# --- BEHAVIOR ---
confirm-close-surface = true
quit-after-last-window-closed = true
window-save-state = always


# --- PERFORMANCE ---
image-storage-limit = 512000000
